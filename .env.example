# Copy to .env for local use. On Hostinger, enter these in the Node.js app's
# Environment variables screen instead of uploading a .env file.

NODE_ENV=production
# Hostinger sets PORT automatically; only set it locally.
# PORT=4000

# MySQL database created in hPanel (Databases -> Management).
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE  (URL-encode special characters in the password)
DATABASE_URL=mysql://u123456789_silverfox:CHANGE_ME@localhost:3306/u123456789_silverfox

# Public address of this API and of the website.
PUBLIC_URL=https://api.silverfoxpropertymanagement.com
FRONTEND_URL=https://silverfoxpropertymanagement.com
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://silverfoxpropertymanagement.com,https://www.silverfoxpropertymanagement.com
# Share the login cookie across the website and API subdomain.
COOKIE_DOMAIN=.silverfoxpropertymanagement.com

# A long random string (at least 32 characters). Never share or commit it.
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARS

# Where uploaded images are stored on the server.
UPLOAD_DIR=uploads
# Number of proxies in front of the app (Hostinger: 1).
TRUST_PROXY=1
# Apply database migrations automatically on start.
RUN_MIGRATIONS=true

# Email for password reset links (Hostinger email: smtp.hostinger.com, port 465).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@silverfoxpropertymanagement.com
SMTP_PASS=CHANGE_ME
MAIL_FROM=Silverfox Property Management <no-reply@silverfoxpropertymanagement.com>

# First staff account, created on first start only if no accounts exist.
# Remove ADMIN_PASSWORD after the first successful start.
ADMIN_EMAIL=info@silverfoxpropertymanagement.co.ke
ADMIN_PASSWORD=CHANGE_ME_MIN_10_CHARS
ADMIN_NAME=Administrator
