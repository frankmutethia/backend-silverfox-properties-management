# Copy to .env for local development. On Hostinger, enter these in the Node.js app's
# Environment Variables panel instead (the .env file is ignored on the live server).

# Hostinger assigns PORT automatically — do not set it there.
PORT=5000
NODE_ENV=development

# MongoDB Atlas: Database -> Connect -> Drivers. Include the database name before the "?".
# Example: mongodb+srv://silverfox_api:<password>@cluster0.xxxxx.mongodb.net/silverfox?retryWrites=true&w=majority
MONGO_URI=

# Long random string (at least 32 characters) used to sign login tokens. Never share it.
ACCESS_TOKEN_SECRET=

# The website address (used for password reset links and allowed automatically for CORS).
FRONTEND_URL=http://localhost:5173
# Extra browser origins allowed to call the API, comma-separated.
CORS_ORIGIN=http://localhost:5173

# Cloudinary (Dashboard -> API Keys). Either CLOUDINARY_URL or the three separate values.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level Cloudinary folder for this site's images.
CLOUDINARY_FOLDER=silverfox

# Email for password reset links and new-testimonial notifications.
# Hostinger: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_USER=no-reply@silverfoxpropertymanagement.com
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Silverfox Property Management <no-reply@silverfoxpropertymanagement.com>
# Inbox that receives every website enquiry.
SMTP_NOTIFICATION_TO=intisarof1997@gmail.com

# First staff account — created on start only when the database has no users.
# Remove SEED_ADMIN_PASSWORD after the first successful start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Load 3 starter journal articles when the database has none. Services and properties are never seeded.
SEED_CONTENT=true
